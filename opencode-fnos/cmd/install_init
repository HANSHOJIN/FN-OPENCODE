#!/bin/bash
set -euo pipefail
wizard_password=${wizard_password:-}
if [[ ${#wizard_password} -lt 12 || $wizard_password == *$'\n'* || $wizard_password == *$'\r'* ]]; then
 printf '%s\n' '请设置至少 12 个字符且不含换行的 Web 密码。' > "$TRIM_TEMP_LOGFILE"
 exit 1
fi
p=${wizard_port:-4096}
if ! [[ $p =~ ^[0-9]{4,5}$ ]] || ((10#$p < 1024 || 10#$p > 65535)); then
 printf '%s\n' '端口须在 1024–65535 之间。' > "$TRIM_TEMP_LOGFILE"
 exit 1
fi
if ! [[ ${wizard_username:-opencode} =~ ^[A-Za-z0-9_.-]{1,64}$ ]]; then
 printf '%s\n' 'Web 用户名格式错误。' > "$TRIM_TEMP_LOGFILE"
 exit 1
fi
